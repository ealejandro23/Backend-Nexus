# =============================================================================
# CONFIGURACIÓN DEL SISTEMA - NEXO RECOMMENDER EP3
# =============================================================================
# Copiar este archivo como .env en el servidor y completar los secretos.
# NUNCA versionar .env. En el servidor:
#   cp .env.example .env && chmod 600 .env
#
# Las variables sin valor toman los defaults seguros de docker-compose.yml.
# =============================================================================

# -----------------------------------------------------------------------------
# Imágenes y borde
# -----------------------------------------------------------------------------
IMAGE_TAG=ep3
DOMAIN=nexo.local

# -----------------------------------------------------------------------------
# Base de datos PostgreSQL
# -----------------------------------------------------------------------------
DB_HOST=db
DB_PORT=5432
DB_NAME=nexo
DB_USER=nexo
DB_PASSWORD=cambiar-esta-clave
# Opcional: si se define, tiene prioridad sobre DB_HOST/PORT/NAME/USER/PASSWORD.
# DATABASE_URL=postgresql://nexo:clave@db:5432/nexo

# -----------------------------------------------------------------------------
# RabbitMQ
# -----------------------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=nexo
RABBITMQ_PASSWORD=cambiar-esta-clave
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=campanas
RABBITMQ_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# NVIDIA LLM (API OpenAI-compatible)
# -----------------------------------------------------------------------------
# Obtener la clave en https://build.nvidia.com/ y dejarla sólo en el servidor.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Desactiva el razonamiento de Nemotron 3 para que "content" traiga el JSON final.
LLM_DISABLE_THINKING=true
LLM_TIMEOUT_SECONDS=20
LLM_MAX_WAIT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_BACKOFF_SECONDS=0.5
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.4

# -----------------------------------------------------------------------------
# AWS / SageMaker / S3 (LabInstanceProfile en EC2)
# -----------------------------------------------------------------------------
# En AWS Academy no se configuran credenciales: las entrega LabInstanceProfile.
AWS_REGION=us-east-1
SAGEMAKER_ENDPOINT_NAME=
S3_BUCKET=
S3_PREFIX=campanas

# -----------------------------------------------------------------------------
# Privacidad
# -----------------------------------------------------------------------------
# Sal usada para seudonimizar usuario_id antes de enviarlo al LLM.
# Cambiar en producción por un valor aleatorio largo.
ANONYMIZATION_SALT=cambiar-por-un-valor-aleatorio-largo

# -----------------------------------------------------------------------------
# Operación
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
HEALTH_TIMEOUT_SECONDS=5
QUEUE_INLINE_FALLBACK=true

# -----------------------------------------------------------------------------
# Servicios de EP2 (se mantienen para el gateway/front/dominio)
# -----------------------------------------------------------------------------
IA_SERVICE_URL=http://ia:8000
API_GATEWAY_URL=http://gateway:8080
MODEL_PATH=/app/modelo_entrenado.pkl
