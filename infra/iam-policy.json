{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3Campanas",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::REEMPLAZAR-BUCKET",
        "arn:aws:s3:::REEMPLAZAR-BUCKET/*"
      ]
    },
    {
      "Sid": "SageMakerInferencia",
      "Effect": "Allow",
      "Action": [
        "sagemaker:InvokeEndpoint",
        "sagemaker:DescribeEndpoint"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CloudWatchLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "*"
    }
  ]
}
